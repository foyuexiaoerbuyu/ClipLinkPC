<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络通信（WebSocket 长连接，见需求 §41-§50） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 连接状态判断（已连接/连接中/断开，见需求 §38） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 前台服务通知（Android 13+ 运行时另需请求，见需求 §91） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 前台服务基础权限（targetSdk 28+ 必须显式声明，否则 startForeground 抛 SecurityException） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- targetSdk 34+ 需按服务类型声明具体权限，本服务类型为 dataSync -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 申请电池优化白名单（§91：后台常驻前提，仅用于拉起系统授权对话框） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Android 11+ 包可见性：需查询 ColorOS 手机管家，才能解析自启动/速冻设置页 -->
    <queries>
        <package android:name="com.oplus.safecenter" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.oplus.battery" />
        <package android:name="com.coloros.oppoguardelf" />
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.IGNORE_BATTERY_OPTIMIZATION_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
        </intent>
    </queries>

    <application
        android:name=".ClipLinkApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 剪贴板同步常驻前台服务（Android 不允许永久后台监听剪贴板，
             通信/同步以后台服务承载，见需求 §91-§92） -->
        <service
            android:name=".service.SyncForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>

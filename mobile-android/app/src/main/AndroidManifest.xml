<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络通信（WebSocket 长连接，见需求 §41-§50） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 连接状态判断（已连接/连接中/断开，见需求 §38） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 前台服务通知（Android 13+ 运行时另需请求，见需求 §91） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 前台服务基础权限（targetSdk 28+ 必须显式声明，否则 startForeground 抛 SecurityException） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- targetSdk 34+ 需按服务类型声明具体权限，本服务类型为 dataSync -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 申请电池优化白名单（§91：后台常驻前提，仅用于拉起系统授权对话框） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Android 11+ 包可见性：需查询 ColorOS 手机管家，才能解析自启动/速冻设置页 -->
    <queries>
        <package android:name="com.oplus.safecenter" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.oplus.battery" />
        <package android:name="com.coloros.oppoguardelf" />
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.IGNORE_BATTERY_OPTIMIZATION_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
        </intent>
        <!-- Android 11+ 包可见性：无障碍设置页跳转前需可解析（见全局任务 4） -->
        <intent>
            <action android:name="android.settings.ACCESSIBILITY_SETTINGS" />
        </intent>
    </queries>

    <application
        android:name=".ClipLinkApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 剪贴板同步常驻前台服务（Android 不允许永久后台监听剪贴板，
             通信/同步以后台服务承载，见需求 §91-§92）。
             stopWithTask=false：任务从最近任务划掉时不销毁服务（§91 保活），
             生命周期改由 onTaskRemoved 中主动处理 -->
        <service
            android:name=".service.SyncForegroundService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />

        <!-- 远程剪贴板通知「复制」按钮接收器（《PC 远程剪贴板通知》spec §8）：
             由 RemoteClipboardNotificationManager 通过 PendingIntent 显式拉起，
             只把通知内容写入系统剪贴板（来源 NOTIFICATION），
             不入库、不上行、不生成 eventId、不启动 MainActivity。
             exported=false：仅本应用可触发，外部应用无法伪造。 -->
        <receiver
            android:name=".notification.CopyNotificationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.cliplink.mobile.action.COPY_REMOTE" />
            </intent-filter>
        </receiver>

        <!-- 后台复制/剪切捕获通道（无障碍服务，见全局任务 2/3）：
             前台监听在应用退到后台后可能收不到剪贴板事件，
             由本服务在系统层面监听文本选择/窗口内容变化，
             捕获到的文本经 SyncManager 复用与前台完全相同的提交入口 -->
        <!-- exported 显式声明为 true 的原因（雷电 Android 14 实测结论）：
             1) 无障碍服务由 system_server 绑定，AOSP checkComponentPermission 对
                uid 0 / 1000 短路放行，故 exported=false 也能被绑定——exported 并非
                「启用后不绑定」的根因（实测证明，勿再据此推断）；
             2) 显式 true 与官方无障碍服务样板一致，规避个别 OEM ROM 在服务可见性 /
                绑定上的差异，向真机（ColorOS）保守对齐；
             3) 安全边界由 android:permission=BIND_ACCESSIBILITY_SERVICE（signature 级，
                仅系统持有）保证，exported=true 不扩大暴露面。
             注意：实测 am force-stop 会清空系统的无障碍启用项并解绑服务，
             验证绑定状态时不要紧接 force-stop。 -->
        <service
            android:name=".accessibility.ClipLinkAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:stopWithTask="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
